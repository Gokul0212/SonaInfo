rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if requester is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // NEWS COLLECTION
    // ----------------------------------------------------
    match /news/{newsId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() && (
        (request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'pending') ||
        isAdmin()
      );
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // ----------------------------------------------------
    // CATEGORIES COLLECTION
    // ----------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------
    // APPLICATIONS COLLECTION
    // ----------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // MESSAGES COLLECTION (User Chatbox & Admin Verification)
    // ----------------------------------------------------
    match /messages/{messageId} {
      // 1. Only admins can view all messages. Authenticated users can view only their own messages.
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // 2. Only authenticated users can submit messages.
      // Newly submitted message must belong to the user and start with 'Pending' status.
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.verifiedAt == null
        && (request.resource.data.messageType == 'General Message' || request.resource.data.messageType == 'Complaint')
        && request.resource.data.subject is string
        && request.resource.data.message is string;

      // 3. Only admins can update messages (e.g., verify or reject). Users cannot alter message status.
      allow update: if isAdmin() 
        && (request.resource.data.status == 'Verified' || request.resource.data.status == 'Rejected')
        && request.resource.data.userId == resource.data.userId; // Prevent reassigning message ownership

      // 4. Only admins can delete messages if required.
      allow delete: if isAdmin();
    }
  }
}
